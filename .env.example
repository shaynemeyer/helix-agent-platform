HELIX_ENV=development
HELIX_MODEL_PROVIDER=deterministic
HELIX_MODEL_NAME=deterministic-v1
HELIX_MODEL_TEMPERATURE=0
HELIX_LOG_LEVEL=INFO

 # Required only when HELIX_MODEL_PROVIDER=openai
OPENAI_API_KEY=

 # Optional LangSmith tracing
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=helix-workspace